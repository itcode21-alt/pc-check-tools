<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac mini 설치 경로: /Users/pandamini/pc-check-tools
    1. 이 파일을 ~/Library/LaunchAgents/kr.co.itsvc.ai-service.plist 로 복사
    2. launchctl load ~/Library/LaunchAgents/kr.co.itsvc.ai-service.plist
    3. 로그 확인: tail -f /tmp/itsvc-ai-service.log
  재부팅해도 FastAPI 서버가 자동으로 다시 뜹니다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>kr.co.itsvc.ai-service</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/pandamini/pc-check-tools/ai-service/.venv/bin/uvicorn</string>
    <string>app:app</string>
    <!-- 외부에서 오는 요청은 전부 cloudflared 터널이 같은 기기 안에서
         127.0.0.1로 넘겨준다. 0.0.0.0으로 열면 집 안 네트워크의 다른 기기도
         인증 없이 이 API를 그대로 호출할 수 있어 루프백으로 묶는다. -->
    <string>--host</string>
    <string>127.0.0.1</string>
    <!-- 8090·8091은 Agent DVR(com.ispy.agent.dvr)이 기본으로 쓴다. 그쪽도
         launchd로 부팅 때 뜨기 때문에, 먼저 뜬 쪽이 포트를 가져가 이 서비스가
         기동에 실패할 수 있다(2026-09-11에 실제로 겪음). 겹치지 않는 포트를
         쓴다. 바꿀 때는 deploy.sh와 ~/.cloudflared/config.yml도 같이 고칠 것. -->
    <string>--port</string>
    <string>8095</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/pandamini/pc-check-tools/ai-service</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key>
    <string>http://localhost:11434</string>
    <key>OLLAMA_MODEL</key>
    <string>qwen3.5:9b</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/itsvc-ai-service.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/itsvc-ai-service.error.log</string>
</dict>
</plist>
