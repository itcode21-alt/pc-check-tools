<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>kr.co.itsvc.ai-service-watch</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/pandamini/pc-check-tools/ai-service/watch-and-deploy.sh</string>
	</array>

	<!-- watch-and-deploy.sh는 자체 while 루프로 WATCH_INTERVAL(5분)마다 확인하는
	     상주 스크립트다. 따라서 launchd가 주기적으로 실행할 필요가 없어
	     StartInterval을 두지 않는다. 아래 KeepAlive가 죽었을 때만 되살린다.
	     (StartInterval을 함께 두면 이미 떠 있는 작업이라 launchd가 새로 띄우지
	     않아 무해하지만, 실제 주기가 5분인지 10분인지 헷갈리게 만든다.) -->

	<!-- 표준 출력/에러를 로그 파일로 리디렉트 -->
	<key>StandardOutPath</key>
	<string>/tmp/ai-service-watch.log</string>

	<key>StandardErrorPath</key>
	<string>/tmp/ai-service-watch-error.log</string>

	<!-- 스크립트가 실패해도 계속 재시작 -->
	<key>KeepAlive</key>
	<true/>

	<!-- 스크립트가 종료되면 15초 대기 후 재시작 -->
	<key>ThrottleInterval</key>
	<integer>15</integer>

	<!-- 환경 설정 -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/pandamini</string>
	</dict>

	<!-- 로그인(및 load) 직후 바로 감시를 시작한다. false로 두면 launchd가
	     띄워줄 계기가 없어 감시가 시작되지 않는다. -->
	<key>RunAtLoad</key>
	<true/>

	<!-- 프로세스 우선순위 (0 = 정상, -20 = 높음, 20 = 낮음) -->
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
