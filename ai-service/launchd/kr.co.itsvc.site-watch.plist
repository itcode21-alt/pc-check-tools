<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>kr.co.itsvc.site-watch</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/pandamini/pc-check-tools/ai-service/site_watch.py</string>
	</array>

	<!-- 매일 09:10에 실행하고, site_watch.py가 마지막 점검 후 2일이 지났을 때만 실제로 점검한다. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>

	<key>WorkingDirectory</key>
	<string>/Users/pandamini/pc-check-tools</string>

	<key>StandardOutPath</key>
	<string>/tmp/site-watch.log</string>

	<key>StandardErrorPath</key>
	<string>/tmp/site-watch-error.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOME</key>
		<string>/Users/pandamini</string>
	</dict>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
