# 실제 값은 ai-service/.env 에 넣으세요 (git에 절대 커밋되지 않도록 .gitignore 처리되어 있습니다).
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# 선택 동의한 AI 문의의 저장 위치와 자동 보관 기간입니다.
AI_INQUIRY_STORAGE_PATH=./data/ai-inquiries.jsonl
AI_INQUIRY_RETENTION_DAYS=90

# ── 분석 결과 AI 요약(미니덤프·이벤트 로그) ──────────────────────────────
# AI 요약은 같은 맥미니의 Ollama를 쓴다(OLLAMA_HOST). 별도 서버를 쓸 때만 OLLAMA_BASE_URL로 덮어쓴다(브라우저에는 노출되지 않는다).
# OLLAMA_BASE_URL=
# 요약 전용 모델(없으면 OLLAMA_MODEL). 5초 안에 답하려면 작은 모델을 권장한다.
# OLLAMA_SUMMARY_MODEL=
OLLAMA_TIMEOUT_MS=5000
OLLAMA_MAX_LOG_CHARS=20000
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_SEC=3600
# 분석 결과(근거 정보)에 서명하는 비밀값. 32자 이상 무작위 문자열을 넣는다. 비우면 서버를 다시 시작할 때마다 기존 토큰이 무효가 된다.
ANALYSIS_TOKEN_SECRET=
ANALYSIS_TOKEN_TTL_SEC=3600

# ── 원격 점검 신청 접수 + 관리자 Telegram 알림 ──────────────────────────
# 사용 보류 중(2026-11-26 사용자 결정): 두 값을 비워 두면 알림 없이 접수만 저장되고(stored) 재전송도 하지 않는다.
# 운영자는 GET /api/remote-inspection-requests/recent (x-repair-token 헤더)로 최근 접수를 확인한다.
# 쓰게 되면 비밀값이므로 브라우저·로그·응답에 절대 내보내지 않는다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# 접수 기록 보관 위치와 기간(일). 기본 ./data/remote-requests.jsonl, 90일.
REMOTE_REQUEST_STORAGE_PATH=./data/remote-requests.jsonl
REMOTE_REQUEST_RETENTION_DAYS=90
REMOTE_REQUEST_RATE_LIMIT_MAX=10
PUBLIC_BASE_URL=https://itsvc.co.kr

# 작은 메모리 덤프의 호출 스택 복원용 모듈 이미지(Microsoft 심볼 서버, msdl.microsoft.com) — 개인정보 방침에 안내돼 있음
# 모듈 파일 이름·TimeDateStamp·SizeOfImage만 보낸다. 끄면(0) 통신하지 않고 캐시에 있는 이미지만 쓴다(방침 문구도 함께 고칠 것).
# SYMBOL_FETCH_ENABLED=1
# SYMBOL_CACHE_DIR=./data/symcache
# SYMBOL_CACHE_MAX_MB=1500
# SYMBOL_DAILY_FETCH_CAP=300
# SYMBOL_HTTP_TIMEOUT_SEC=15
