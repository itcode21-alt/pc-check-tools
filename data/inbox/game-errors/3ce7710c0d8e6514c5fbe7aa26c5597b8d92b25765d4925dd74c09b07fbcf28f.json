  "text": "<!DOCTYPE html>\r\n<!--[if IE 8]><html lang=\"ko\" class=\"ie8\"><![endif]-->\r\n<!--[if gt IE 9]><!-->\r\n<html lang=\"ko\">\r\n<!--<![endif]-->\r\n<head>\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta charset=\"utf-8\">\r\n    <meta name=\"keywords\" content=\"\">\r\n    <meta name=\"description\" content=\"\">\r\n    <title>고객센터 | 넥슨</title>\r\n    \r\n    <link rel=\"shortcut icon\" href=\"https://ssl.nexon.com/s2/portal/nexon/image/nexon/nexon.ico\" />\r\n    <link href=\"/css/sub_footer.css\" type=\"text/css\" rel=\"stylesheet\" />\r\n    <link rel=\"stylesheet\" href=\"/css/bundle.css\" />\r\n    <script type=\"text/javascript\" src=\"/lib/jquery/dist/jquery.min.js?v=zp0HUArZHsK1JMJwdk7EyaM-eDINjTdOxADt5Ij2JRs\"></script>\r\n    <script src=\"/js/bundle-common.js\" type=\"text/javascript\"></script>\r\n    <script type=\"text/javascript\" src=\"/js/common/adjustHeaderPath.js\"> </script> \r\n</head>\r\n<body class=\"index_page_body\">\r\n    <div class=\"dimm\">\r\n        <img src=\"/images/common/blank_size_100.png\" alt=\"blank\">\r\n    </div>\r\n    <div id=\"wrap\" class=\"help_layer_bg\">\r\n        <div id=\"header\">\r\n            <ul class=\"skipnav\">\r\n    <li>\r\n        <a href=\"#content\">컨텐츠 바로가기</a>\r\n    </li>\r\n</ul>\r\n        </div>\r\n        <div id=\"help_container\">\r\n            <div class=\"help_leftmenu\">\r\n                \r\n<ul class=\"menu_wrap\">\r\n    <li id=\"onlineTab\" class=\"banner_platform_tab\">\r\n        <a href=\"javascript:SetClickLogToDirect('LandingPartial', '' , '/?ismobile=0');\">\r\n            온라인\r\n            <br>게임\r\n        </a>\r\n    </li>\r\n    <li id=\"mobileTab\" class=\"banner_platform_tab\">\r\n        <a href=\"javascript:SetClickLogToDirect('LandingPartial', '', '/?ismobile=1');\">\r\n            모바일\r\n            <br>게임\r\n        </a>\r\n    </li>\r\n</ul>\r\n<ul class=\"bn_wrap\">\r\n            <li>\r\n                <a href=\"javascript:void(0);\" class=\"banner\" data-bannerid=\"1\" data-target=\"0\" data-href=\"https://security-center.nexon.com/\">\r\n                    <img src=\"http://help.nexon.com/image/banner/20250402113731833.png\" alt=\"&#xBCF4;&#xC548;&#xC13C;&#xD130;\" />\r\n                </a>\r\n            </li>\r\n            <li>\r\n                <a href=\"javascript:void(0);\" class=\"banner\" data-bannerid=\"2\" data-target=\"0\" data-href=\"https://schoolzone.nexon.com/page/nx.aspx?URL=Home/Index\">\r\n                    <img src=\"http://help.nexon.com/image/banner/20250402113818549.png\" alt=\"&#xC2A4;&#xCFE8;&#xC874;\" />\r\n                </a>\r\n            </li>\r\n</ul>\r\n<ul class=\"menu_wrap02\">\r\n    <li>\r\n        <a href=\"javascript:SetClickLogToDirect('Help_QnAguide', '', '/QnA/QnAGuide');\" title=\"문의방법\"> 문의방법</a>\r\n    </li>\r\n    <li>\r\n        <a href=\"javascript:SetClickLogToDirect('Help_HelpDownload', '', '/Download/ngm');\" title=\"다운로드\">다운로드</a>\r\n    </li>\r\n    <li>\r\n        <a href=\"javascript:SetClickLogToDirect('Help_Report', '', '/Report/Reportguide');\" title=\"신고하기\">신고하기</a>\r\n    </li>\r\n</ul>\r\n<script>\r\n    $(\".banner\").bind(\"click\", function (e) {\r\n        switch ($(this).data(\"bannerid\")) {\r\n            case 1:\r\n                SetClickLog('Help_security', '');\r\n                break;\r\n            case 4:\r\n                SetClickLog('Help_schoolzone', '');\r\n                break;\r\n            case 74:\r\n                SetClickLog('Help_popuphelpview', '');\r\n                break;\r\n            default:\r\n                break;\r\n        }\r\n\r\n        if ($(this).data(\"target\") == 1) {\r\n            window.open($(this).data(\"href\"), '_blank');\r\n        } else {\r\n            window.open($(this).data('href'), '_parent');\r\n        }\r\n    });\r\n</script>\r\n\r\n            </div>\r\n              \r\n<div class=\"help_landing_wrap\">\r\n    <div class=\"left_layer_popup\">\r\n        <h2 class=\"tit_1dep\">다운로드</h2>\r\n        <p class=\"sub_copy_1dep\">\r\n            넥슨플러그, 넥슨게임매니저, 그래픽드라이버 등 게임 플레이에\r\n            <br>유용한 프로그램을 다운로드 하실 수 있습니다.\r\n        </p>\r\n        <ul class=\"help_download_tab clfix\">\r\n            <li>\r\n                <a href=\"javascript:SetClickLogToDirect('HelpDownload_ngm', '', '/Download/ngm');\">넥슨게임매니저</a>\r\n            </li>\r\n            <li>\r\n                <a href=\"javascript:SetClickLog('HelpDownload_NexonPlug', '');window.open('https://nexonplug.nexon.com');\">넥슨플러그</a>\r\n            </li>\r\n            <li>\r\n\t\t\t\t<a href=\"javascript:SetClickLogToDirect('HelpDownload_GraphicDownload', '', '/Download/GraphicDownload');\">드라이버 다운로드</a>\r\n            </li>\r\n            <li class=\"on\">\r\n                <a href=\"javascript:SetClickLogToDirect('HelpDownload_Restore', '', '/Download/Restore');\">에러복구프로그램</a>\r\n            </li>\r\n        </ul>\r\n        <strong class=\"tit_2dep\">에러복구프로그램</strong>\r\n        <div class=\"help_content_tab_bx\">\r\n            <div class=\"white_bx help_down_refer_bx\">\r\n                <strong class=\"notice_txt\">넥슨 에러복구프로그램은 아래의 경우에 설치해주세요.</strong>\r\n                <ul>\r\n                    <li>- 넥슨 로그인이 실패 시</li>\r\n                    <li>- 넥슨 모듈 패치 시 실패 시</li>\r\n                    <li>- 게임실행 및 패치 실패 및 오류 시</li>\r\n                </ul>\r\n                <a id=\"downngm\" href=\"javascript:void(0)\">\r\n                    <img src=\"/images/common/btn_help_error.gif\" alt=\"넥슨 에러복구프로그램 다운로드\">\r\n                </a>\r\n            </div>\r\n            <div class=\"white_bx help_nexon_error clfix\">\r\n                <strong>넥슨 에러복구프로그램</strong>\r\n                <div class=\"error_img_bx\">\r\n                    <img src=\"/images/common/img_help_error01.png\" alt=\"넥슨 에러복구프로그램 이미지\">\r\n                </div>\r\n                <div class=\"error_text_bx\">\r\n                    <ul>\r\n                        <li>\r\n                            <span>01</span>에러복구 프로그램을 다운받아 저장하세요.\r\n                        </li>\r\n                        <li>\r\n                            <span>02</span>다운받은 프로그램(NexonRepair.exe)을 실행하면 <br>자동으로 복구가 진행됩니다.<br>\r\n                            <span class=\"msg\">(실행 전, 작업 중인 웹 프로그램들을 저장하세요.)</span>\r\n                        </li>\r\n                        <li>\r\n                            <span>03</span>완료 후 넥슨홈페이지로 오셔서 게임을 이용하세요~!\r\n                        </li>\r\n                    </ul>\r\n                    <p class=\"notice_txt\">\r\n                        ※ 주의 : 지정PC 서비스를 이용하실 경우,\r\n                        <br>에러복구프로그램 설치 후 지정PC 재등록을 해주셔야 합니다.\r\n                    </p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <a href=\"/\" title=\"닫기\" class=\"btn_left_close\">\r\n            <img src=\"/images/common/btn_close03.png\" alt=\"close\">\r\n        </a>\r\n    </div>\r\n</div>\r\n\r\n  \r\n            \r\n            \r\n        <script src=\"https://platform.nexon.com/ngm/js/npf_ngm.js\" type=\"text/javascript\"></script>\r\n    <script src=\"/js/download/Nexon.Download.Restore.js\" type=\"text/javascript\"></script>\r\n\r\n        </div>\r\n        <div id=\"footer\">\r\n            <div class=\"footer\"><p>© NEXON Corporation. All Rights Reserved.</p></div>\r\n        </div>\r\n    </div>\r\n    <script type=\"text/javascript\" src=\"https://rs.nxfs.nexon.com/common/js/gnb.min.js\" data-gamecode=\"65526\" data-ispublicbanner=\"false\"></script>\r\n    <script type=\"text/javascript\" src=\"https://rs.nxfs.nexon.com/common/js/lnb.min.js\"></script>\r\n</body>\r\n</html>\r\n"
}
