25EC%2599%25B8%25EC%2582%25AC%25EC%259D%25B4%25ED%258A%25B8-%25EC%259D%25B8%25EC%259A%25A9/50921.rss\" />\n    <meta property=\"og:site_name\" content=\"Overwatch Forums\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta name=\"twitter:card\" content=\"summary_large_image\" />\n<meta name=\"twitter:image\" content=\"https://d3q0exo1kbforn.cloudfront.net/original/1X/0ea4418b963b4e44e092609b557a1e75a4546d8a.png\" />\n<meta property=\"og:image\" content=\"https://d3q0exo1kbforn.cloudfront.net/original/1X/0ea4418b963b4e44e092609b557a1e75a4546d8a.png\" />\n<meta property=\"og:url\" content=\"https://kr.forums.blizzard.com/ko/overwatch/t/%EC%98%A4%EB%B2%84%EC%9B%8C%EC%B9%982-%EA%B2%80%EC%9D%80%ED%99%94%EB%A9%B4-%EB%A9%88%EC%B6%A4-%ED%95%B4%EA%B2%B0-%EB%B0%A9%EB%B2%95-%ED%95%B4%EC%99%B8%EC%82%AC%EC%9D%B4%ED%8A%B8-%EC%9D%B8%EC%9A%A9/50921\" />\n<meta name=\"twitter:url\" content=\"https://kr.forums.blizzard.com/ko/overwatch/t/%EC%98%A4%EB%B2%84%EC%9B%8C%EC%B9%982-%EA%B2%80%EC%9D%80%ED%99%94%EB%A9%B4-%EB%A9%88%EC%B6%A4-%ED%95%B4%EA%B2%B0-%EB%B0%A9%EB%B2%95-%ED%95%B4%EC%99%B8%EC%82%AC%EC%9D%B4%ED%8A%B8-%EC%9D%B8%EC%9A%A9/50921\" />\n<meta property=\"og:title\" content=\"오버워치2 검은화면 멈춤 해결 방법 - 해외사이트 인용\" />\n<meta name=\"twitter:title\" content=\"오버워치2 검은화면 멈춤 해결 방법 - 해외사이트 인용\" />\n<meta property=\"og:description\" content=\"현재 같은 문제가 외국에서도 발생하고 있습니다. 알려진 바로는 2개의 코어, 4스레드 CPU에서 같은 문제가 발생한다고 하네요. 블리자드의 답변도 있습니다.(조치 하겠다는 뭐 그런 내용?)  위 링크에서 효과를 보았다는 방법은 다음 내용과 같습니다.  최대 59FPS 설정  전체화면  동적 렌더 스케일 비활성화  –tank_WorkerThreadCount 2-thread 2  오버워치 플레이 탭 옆 톱니바퀴 &gt; 명령줄 인수 추가 클릭 &gt; 해당 명령어 추가  또는 직접 BIOS에서 하이퍼 스레딩 비활성화 하는 방법   ###### 명령줄 기존 방법에서 업그레이드입니다.\" />\n<meta name=\"twitter:description\" content=\"현재 같은 문제가 외국에서도 발생하고 있습니다. 알려진 바로는 2개의 코어, 4스레드 CPU에서 같은 문제가 발생한다고 하네요. 블리자드의 답변도 있습니다.(조치 하겠다는 뭐 그런 내용?)  위 링크에서 효과를 보았다는 방법은 다음 내용과 같습니다.  최대 59FPS 설정  전체화면  동적 렌더 스케일 비활성화  –tank_WorkerThreadCount 2-thread 2  오버워치 플레이 탭 옆 톱니바퀴 &gt; 명령줄 인수 추가 클릭 &gt; 해당 명령어 추가  또는 직접 BIOS에서 하이퍼 스레딩 비활성화 하는 방법   ###### 명령줄 기존 방법에서 업그레이드입니다.\" />\n<meta property=\"og:article:section\" content=\"기술 지원\" />\n<meta property=\"og:article:section:color\" content=\"AB9364\" />\n<meta name=\"twitter:label1\" value=\"읽은 시간\" />\n<meta name=\"twitter:data1\" value=\"1 mins 🕑\" />\n<meta name=\"twitter:label2\" value=\"좋아요\" />\n<meta name=\"twitter:data2\" value=\"1 ❤\" />\n<meta property=\"article:published_time\" content=\"2022-10-10T11:28:26+00:00\" />\n<meta property=\"og:ignore_canonical\" content=\"true\" />\n\n\n    <script type=\"application/ld+json\">{\"@context\":\"http://schema.org\",\"@type\":\"QAPage\",\"name\":\"오버워치2 검은화면 멈춤 해결 방법 - 해외사이트 인용\",\"mainEntity\":{\"@type\":\"Question\",\"name\":\"오버워치2 검은화면 멈춤 해결 방법 - 해외사이트 인용\",\"text\":\"현재 같은 문제가 외국에서도 발생하고 있습니다. 알려진 바로는 2개의 코어, 4스레드 CPU에서 같은 문제가 발생한다고 하네요. 블리자드의 답변도 있습니다.(조치 하겠다는 뭐 그런 내용?)\\n\\n위 링크에서 효과를 보았다는 방법은 다음 내용과 같습니다.\\n\\n최대 59FPS 설정\\n\\n전체화면\\n\\n동적 렌더 스케일 비활성화\\n\\n–tank_WorkerThreadCount 2-thread 2\\n\\n오버워치 플레이 탭 옆 톱니바퀴 &gt; 명령줄 인수 추가 클릭 &gt; 해당 명령어 추가\\n\\n또는 직접 BIOS에서 하이퍼 스레딩 비활성화 하는 방법\\n\\n[이&hellip;\",\"upvoteCount\":1,\"answerCount\":0,\"datePublished\":\"2022-10-10T11:28:25.851Z\",\"author\":{\"@type\":\"Person\",\"name\":\"송하나19-3984\",\"url\":\"https://kr.forums.blizzard.com/ko/overwatch/u/%EC%86%A1%ED%95%98%EB%82%9819-3984\"}}}</script>\n  </head>\n  <body class=\"crawler \">\n    \n    <header>\n  <a href=\"/ko/overwatch/\">Overwatch Forums</a>\n</header>\n\n    <div id=\"main-outlet\" class=\"wrap\" role=\"main\">\n        <div id=\"topic-title\">\n    <h1>\n      <a href=\"/ko/overwatch/t/%EC%98%A4%EB%B2%84%EC%9B%8C%EC%B9%982-%EA%B2%80%EC%9D%80%ED%99%94%EB%A9%B4-%EB%A9%88%EC%B6%A4-%ED%95%B4%EA%B2%B0-%EB%B0%A9%EB%B2%95-%ED%95%B4%EC%99%B8%EC%82%AC%EC%9D%B4%ED%8A%B8-%EC%9D%B8%EC%9A%A9/50921\">오버워치2 검은화면 멈춤 해결 방법 - 해외사이트 인용</a>\n    </h1>\n\n      <div class=\"topic-category\" itemscope itemtype=\"http://schema.org/BreadcrumbList\">\n          <span itemprop=\"itemListElement\" itemscope itemtype=\"http://schema.org/ListItem\">\n            <a href=\"/ko/overwatch/c/technical-support/8\" class=\"badge-wrapper bullet\" itemprop=\"item\">\n              <span class='badge-category-bg' style='background-color: #AB9364'></span>\n              <span class='badge-category clear-badge'>\n                <span class='category-name' itemprop='name'>기술 지원</span>\n              </span>\n            </a>\n            <meta itemprop=\"position\" content=\"1\" />\n          </span>\n      </div>\n\n  </div>\n\n  \n\n    <div itemscope itemtype='http://schema.org/DiscussionForumPosting'>\n      <meta itemprop='headline' content='오버워치2 검은화면 멈춤 해결 방법 - 해외사이트 인용'>\n      <link itemprop='url' href='https://kr.forums.blizzard.com/ko/overwatch/t/%EC%98%A4%EB%B2%84%EC%9B%8C%EC%B9%982-%EA%B2%80%EC%9D%80%ED%99%94%EB%A9%B4-%EB%A9%88%EC%B6%A4-%ED%95%B4%EA%B2%B0-%EB%B0%A9%EB%B2%95-%ED%95%B4%EC%99%B8%EC%82%AC%EC%9D%B4%ED%8A%B8-%EC%9D%B8%EC%9A%A9/50921'>\n      <meta itemprop='datePublished' content='2022-10-10T11:28:25Z'>\n        <meta itemprop='articleSection' content='기술 지원'>\n      <meta itemprop='keywords' content=''>\n      <div itemprop='publisher' itemscope itemtype=\"http://schema.org/Organization\">\n        <meta itemprop='name' content='Overwatch Forums'>\n          <div itemprop='logo' itemscope itemtype=\"http://schema.org/ImageObject\">\n            <meta itemprop='url' content='https://d3q0exo1kbforn.cloudfront.net/original/1X/e9d52add3f186cd5f4c40b249ebec06ff3d847da.png'>\n          </div>\n      </div>\n\n\n          <div id='post_1'  class='topic-body crawler-post'>\n            <div class='crawler-post-meta'>\n              <span class=\"creator\" itemprop=\"author\" itemscope itemtype=\"http://schema.org/Person\">\n                <a itemprop=\"url\" rel='nofollow' href='https://kr.forums.blizzard.com/ko/overwatch/u/송하나19-3984'><span itemprop='name'>송하나19-3984</span></a>\n                \n              </span>\n\n                <link itemprop=\"mainEntityOfPage\" href=\"https://kr.forums.blizzard.com/ko/overwatch/t/%EC%98%A4%EB%B2%84%EC%9B%8C%EC%B9%982-%EA%B2%80%EC%9D%80%ED%99%94%EB%A9%B4-%EB%A9%88%EC%B6%A4-%ED%95%B4%EA%B2%B0-%EB%B0%A9%EB%B2%95-%ED%95%B4%EC%99%B8%EC%82%AC%EC%9D%B4%ED%8A%B8-%EC%9D%B8%EC%9A%A9/50921\">\n\n\n              <span class=\"crawler-post-infos\">\n                  <time  datetime='2022-10-10T11:28:26Z' class='post-time'>\n                    2022년 10월월 10일 11:28오전\n                  </time>\n                  <meta itemprop='dateModified' content='2022-10-10T11:30:01Z'>\n              <span itemprop='position'>1</span>\n              </span>\n            </div>\n            <div class='post' itemprop='text'>\n              <p>현재 같은 문제가 외국에서도 발생하고 있습니다. 알려진 바로는 2개의 코어, 4스레드 CPU에서 같은 문제가 발생한다고 하네요. 블리자드의 답변도 있습니다.(조치 하겠다는 뭐 그런 내용?)</p>\n<p>위 링크에서 효과를 보았다는 방법은 다음 내용과 같습니다.</p>\n<p>최대 59FPS 설정<br>\n전체화면<br>\n동적 렌더 스케일 비활성화<br>\n–tank_WorkerThreadCount 2-thread 2<br>\n오버워치 플레이 탭 옆 톱니바퀴 &gt; 명령줄 인수 추가 클릭 &gt; 해당 명령어 추가<br>\n또는 직접 BIOS에서 하이퍼 스레딩 비활성화 하는 방법</p><aside class=\"onebox allowlistedgeneric\" data-onebox-src=\"https://us.forums.blizzard.com/en/overwatch/t/main-thread-game-freezing-with-intel-i3-dual-core-cpus/695966/1626\">\n  <header class=\"source\">\n      <img src=\"https://d74zh8edaijub.cloudfront.net/optimized/1X/e9d52add3f186cd5f4c40b249ebec06ff3d847da_2_32x32.png\" class=\"site-icon\" width=\"32\" height=\"32\">\n\n      <a href=\"https://us.forums.blizzard.com/en/overwatch/t/main-thread-game-freezing-with-intel-i3-dual-core-cpus/695966/1626\" target=\"_blank\" rel=\"noopener nofollow ugc\" title=\"06:46AM - 08 October 2022\">Overwatch Forums – 8 Oct 22</a>\n  </header>\n\n  <article class=\"onebox-body\">\n    <img src=\"https://d74zh8edaijub.cloudfront.net/original/1X/0ea4418b963b4e44e092609b557a1e75a4546d8a.png\" class=\"thumbnail onebox-avatar\" width=\"280\" height=\"280\">\n\n<h3><a href=\"https://us.forums.blizzard.com/en/overwatch/t/main-thread-game-freezing-with-intel-i3-dual-core-cpus/695966/1626\" target=\"_blank\" rel=\"noopener nofollow ugc\">[Main Thread] Game freezing with Intel i3 / Dual core CPUs</a></h3>\n\n  <p>Take a look at this one</p>\n\n\n  </article>\n\n  <div class=\"onebox-metadata\">\n    \n    \n  </div>\n\n  <div style=\"clear: both\"></div>\n</aside>\n\n<p><strong>###### 명령줄 기존 방법에서 업그레이드입니다.</strong></p>\n            </div>\n\n            <div itemprop=\"interactionStatistic\" itemscope itemtype=\"http://schema.org/InteractionCounter\">\n              <meta itemprop=\"interactionType\" content=\"http://schema.org/LikeAction\"/>\n              <meta itemprop=\"userInteractionCount\" content=\"1\" />\n              <span class='post-likes'>좋아요 1개</span>\n            </div>\n\n                <div class='crawler-linkback-list'>\n                    <div>\n                      <a href=\"https://kr.forums.blizzard.com/ko/overwatch/t/%EA%B2%9C%ED%95%98%EB%8B%A4%EA%B0%80-%EB%AA%A8%EB%8B%88%ED%84%B0-%EB%A9%88%EC%B6%94%EA%B3%A0-%EA%B2%80%EC%9D%80%EC%83%89-%EB%82%98%EC%98%A4%EB%8A%94-%ED%98%84%EC%83%81/50901/2\">겜하다가 모니터 멈추고 검은색 나오는 현상</a>\n                    </div>\n                </div>\n\n            \n          </div>\n    </div>\n\n\n    \n\n\n\n\n    </div>\n    <footer class=\"container wrap\">\n  <nav class='crawler-nav'>\n    <ul>\n      <li itemscope itemtype='http://schema.org/SiteNavigationElement'>\n        <span itemprop='name'>\n          <a href='/ko/overwatch/' itemprop=\"url\">홈 </a>\n        </span>\n      </li>\n      <li itemscope itemtype='http://schema.org/SiteNavigationElement'>\n        <span itemprop='name'>\n          <a href='/ko/overwatch/categories' itemprop=\"url\">카테고리 </a>\n        </span>\n      </li>\n      <li itemscope itemtype='http://schema.org/SiteNavigationElement'>\n        <span itemprop='name'>\n          <a href='/ko/overwatch/guidelines' itemprop=\"url\">가이드라인 </a>\n        </span>\n      </li>\n        <li itemscope itemtype='http://schema.org/SiteNavig